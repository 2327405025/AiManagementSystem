# Optional. Without a key, deterministic local AI rules are used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional tuning. Docker Compose wires Redis and Chroma automatically.
CACHE_LOCAL_MAX_SIZE=10000
CACHE_LOCAL_TTL=60s
CACHE_REDIS_TTL=5m
DB_POOL_MAX=16
