# DeepSeek uses the OpenAI-compatible protocol. Keep the real key only in .env.
# DeepSeek 使用 OpenAI 兼容协议；真实密钥只写入 .env。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# Optional tuning / 可选调优项
CACHE_LOCAL_MAX_SIZE=10000
CACHE_LOCAL_TTL=60s
CACHE_REDIS_TTL=5m
DB_POOL_MAX=16
