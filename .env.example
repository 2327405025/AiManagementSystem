# DeepSeek uses the OpenAI-compatible protocol. Keep the real key only in .env.
# DeepSeek 使用 OpenAI 兼容协议；真实密钥只写入 .env。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-flash

# Optional. Used to sign login tokens. Keep the real value only in .env.
# 可选。用于签发登录 Token；真实值只写入 .env。
JWT_SECRET=dev-only-jwt-secret-change-me-32b

# Optional tuning / 可选调优项
CACHE_LOCAL_MAX_SIZE=10000
CACHE_LOCAL_TTL=60s
CACHE_REDIS_TTL=5m
DB_POOL_MAX=16
